NODE_DB_HOST=snodes.allstarlink.org
URI="diffnodes.php"
NODE_URL="https://${NODE_DB_HOST}/${URI}"
USERAGENT="asl3-update-nodelist/1.0"

FILEPATH=/var/lib/asterisk
NODELIST=rpt_extnodes
EXTNODES=$FILEPATH/$NODELIST
# Holds (as its modification time) the server's Last-Modified for the list we have.
STAMP_FILE=$FILEPATH/asl3un-lastmod

# both-mode throttle: rpt_extnodes is DNS failover only (see issue #11)
# BOTH_UPDATE_INTERVAL may be overridden via
# systemctl edit asl3-update-nodelist.service (see asl3-update-nodelist(1)).
BOTH_UPDATE_INTERVAL=${BOTH_UPDATE_INTERVAL:-86400}
DEFAULT_DNS_NODE_DOMAIN=nodes.allstarlink.org

downloadNodelist() {
	#echo "downloading \"${NODE_URL}\""
	# --compressed: ask for gzip and decompress it (the ~750 KB list arrives as ~190 KB).
	# -z: send If-Modified-Since from the stamp file, so an unchanged list is a bodiless 304.
	# -R: give the download the server's Last-Modified, which writeNodelist copies to the stamp
	# file, so -z compares server time with server time and a wrong local clock doesn't matter.
	# No stamp yet (a new install, or one upgraded from wget) or no list: download in full.
	local since=()
	[ -s "${EXTNODES}" ] && [ -f "${STAMP_FILE}" ] && since=(-z "${STAMP_FILE}")
	HTTP_CODE=$(curl -sS --fail --compressed --location --retry 3 -R "${since[@]}" \
		--user-agent "$USERAGENT" -o "$EXTNODESTMP" -w '%{http_code}' "${NODE_URL}")
	if [ $? -ne 0 ]; then
		echo "failed to download from ${NODE_URL}"
		rm -f $EXTNODESTMP
		exit 1
	fi
}

writeNodelist() {
	# Q? does app_rpt need the file not to change?
	cat ${1} > ${EXTNODES}
	# The server's Last-Modified for this list (curl -R), for the next run's -z.
	touch -r ${EXTNODESTMP} ${STAMP_FILE}
	#echo "${NODELIST} updated"
}

# Return 0 when the node DNS domain appears reachable.
dnsProbe() {
	local domain

	if [ -r /etc/asterisk/rpt.conf ]; then
		domain=$(grep -iE '^dns_node_domain' /etc/asterisk/rpt.conf | \
			perl -pe 's/^dns_node_domain\s?=\s?(\S+).*$/$1/gi' | \
			tr '[:upper:]' '[:lower:]' | tail -n1)
	fi
	domain=${domain:-${DEFAULT_DNS_NODE_DOMAIN}}
	host -t SOA "${domain}" >/dev/null 2>&1
}

# Return 0 when a both-mode update should be skipped.
shouldThrottleBothMode() {
	local now file_mtime file_age

	if [ ! -s "${EXTNODES}" ]; then
		return 1
	fi

	now=$(date +%s)
	file_mtime=$(stat -c %Y "${EXTNODES}" 2>/dev/null || echo 0)
	file_age=$(( now - file_mtime ))
	if [ "${file_age}" -ge "${BOTH_UPDATE_INTERVAL}" ]; then
		return 1
	fi

	if ! dnsProbe; then
		return 1
	fi

	return 0
}

# Check to see if this host is even using me
# Values are read from /etc/asterisk/rpt.conf directly (not #include files).
LUT=$( grep -iE '^node_lookup_method' /etc/asterisk/rpt.conf | \
	perl -pe 's/^node_lookup_method\s?=\s?(\S+).*$/$1/gi' | tr '[:upper:]' '[:lower:]' | tail -n1)
if [ "x${LUT}" = "xdns" ]; then
	echo "node_lookup_method = dns; skipping"
	exit 0
fi

if [ "x${LUT}" = "xboth" ] && shouldThrottleBothMode; then
	echo "node_lookup_method = both; skipping"
	exit 0
fi

# Download the Nodelist
EXTNODESTMP=$(mktemp)
downloadNodelist
if [ "${HTTP_CODE}" = "304" ]; then
	#echo "${NODELIST} unchanged"
	# Checked and current: restart the both-mode throttle window. Only rpt_extnodes; the stamp
	# file's time is the server's Last-Modified, which -z depends on.
	touch ${EXTNODES}
	rm -f $EXTNODESTMP
	exit 0
fi

# The server sends the whole list, its first line ";Full". Anything else (an error page from
# something in the way, say) isn't a node list: keep the one we have.
if [ "$(head -n1 ${EXTNODESTMP} | tr -d '\r')" != ";Full" ]; then
	echo "download from ${NODE_URL} is not a node list; keeping ${EXTNODES}"
	rm -f $EXTNODESTMP
	exit 1
fi
writeNodelist ${EXTNODESTMP}
rm $EXTNODESTMP

if [ ${USER} != "asterisk" ]; then
	chown asterisk:asterisk ${EXTNODES} ${STAMP_FILE}
	chmod 644 ${EXTNODES} ${STAMP_FILE}
fi

exit 0
